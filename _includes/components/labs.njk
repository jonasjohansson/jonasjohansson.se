<div id="labs" class="labs">
  <p class="labs-intro">Tools, experiments, and resources.</p>

  <div class="labs-grid">
    {% for lab in labsContent %}
    {% if lab.url %}
    <a href="{{ lab.url }}" class="labs-card" target="_blank" rel="noopener noreferrer">
      <h3 class="labs-card-title">{{ lab.title }}{% if lab.logo %} <img class="labs-card-logo" src="{{ lab.logo }}" alt="">{% endif %}</h3>
      {% if lab.description %}<p class="labs-card-desc">{{ lab.description }}</p>{% endif %}
    </a>
    {% else %}
    <div class="labs-card">
      <h3 class="labs-card-title">{{ lab.title }}{% if lab.logo %} <img class="labs-card-logo" src="{{ lab.logo }}" alt="">{% endif %}</h3>
      {% if lab.description %}<p class="labs-card-desc">{{ lab.description }}</p>{% endif %}
    </div>
    {% endif %}
    {% endfor %}
  </div>
</div>
