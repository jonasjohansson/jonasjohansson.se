<header
  id="header"
  style="display: none">
  <div class="header-center">
    <div
      class="header-content"
      id="header-toggle">
      <h1 class="header-title">
        {{ site.title | upper }}
      </h1>
      <div class="header-subtitle" id="header-subtitle">
        {% if project %}
        {{ projectContent[project.slug].title }}
        {% else %}
        {{ site.subtitle }}
        {% endif %}
      </div>
      <div class="header-links" id="header-links" style="display: none;">
        <a href="mailto:{{ site.email }}" class="header-link">EMAIL</a>
      </div>
    </div>
  </div>
</header>
