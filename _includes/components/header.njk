<header
  id="header"
  style="display: none">
  <div class="header-center">
    <div
      class="header-content"
      id="header-toggle">
      <div class="header-title">
        {{ site.title | upper }}
      </div>
      <div class="header-subtitle">
        {% if project %}
        {{ projectContent[project.slug].title }}
        {% else %}
        {{ site.subtitle }}
        {% endif %}
      </div>
    </div>
  </div>
</header>
