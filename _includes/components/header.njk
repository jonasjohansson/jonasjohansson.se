<header id="header">
  {% include "../components/about-curtain.njk" %}

  <div
    class="header-content"
    id="island-handle">
    <div class="header-text-left">
      <div class="header-title">{{ site.title | upper }}</div>
    </div>
    <div class="header-text-right">
      <div class="header-subtitle">
        {% if project %}
        {{ projectContent[project.slug].title }}
        {% else %}
        {{ site.subtitle }}
        {% endif %}
      </div>
    </div>
  </div>
</header>
