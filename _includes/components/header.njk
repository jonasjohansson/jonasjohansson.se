<header id="header">
  <a
    href="/"
    class="header-content">
    <div class="header-text">
      <div class="header-title">{{ site.title | upper }}</div>
      <div class="header-subtitle">
        {% if project %}
        {{ projectContent[project.slug].title }}
        {% else %}
        {{ site.subtitle }}
        {% endif %}
      </div>
    </div>
  </a>
</header>
