<header
  id="header"
  style="display: none">
  <div class="header-center">
    <a
      class="header-content"
      id="header-toggle"
      href="{{ site.aboutUrl or '/' }}"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="About Jonas Johansson">
      <h1 class="header-title">
        {{ site.title | upper }}
      </h1>
      <div class="header-subtitle" id="header-subtitle" data-default-subtitle="{{ site.subtitle }}">
        {% if project %}
        {{ projectContent[project.slug].title }}
        {% else %}
        {{ site.subtitle }}
        {% endif %}
      </div>
    </a>
  </div>
</header>
