<nav class="header-contacts" aria-label="Contact and social links">
  {%- for contact in site.contacts %}
  <a href="{{ contact.href }}" aria-label="{{ contact.label }}" title="{{ contact.label }}">{%- if contact.icon == "labs" %}<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 3h6"/><path d="M10 3v6l-5.6 9.6A1 1 0 0 0 5.3 20h13.4a1 1 0 0 0 .9-1.4L14 9V3"/><path d="M7.5 15h9"/></svg>{% elif contact.icon == "instagram" %}<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.4" cy="6.6" r="0.6" fill="currentColor" stroke="none"/></svg>{% elif contact.icon == "cv" %}<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 2h8l5 5v15H6z"/><path d="M14 2v5h5"/><path d="M9 12h6M9 16h6"/></svg>{% elif contact.icon == "email" %}<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>{% endif %}<span class="sr-only">{{ contact.label }}</span></a>
  {%- endfor %}
</nav>
