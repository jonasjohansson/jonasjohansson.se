<section id="collection" class="collection" aria-labelledby="collection-title" data-view="index">
  <h2 id="collection-title" class="sr-only" tabindex="-1">{% if project %}More projects{% else %}Projects{% endif %}</h2>
  <nav id="strips" aria-label="Projects">
    {% for item in collectionItems %}
    {% if item.upcoming %}
    <div class="strip strip-upcoming" id="strip-{{ item.slug }}" aria-disabled="true"
      data-project="{{ item.slug }}">
      <span class="strip-label">{{ item.title }}</span>
      <span class="strip-meta">In progress</span>
    </div>
    {% else %}
    <a class="strip" id="strip-{{ item.slug }}" data-project-link
      href="{{ ('/' ~ item.slug ~ '/') | url }}"
      data-project="{{ item.slug }}"{% if item.color %} style="--project-color: {{ item.color }}"{% endif %}
      {% if project and project.slug == item.slug %} hidden{% endif %}>
      <span class="strip-label">{{ item.title }}</span>
      <span class="strip-meta">{{ item.tags | join(' · ') }}<span class="strip-year">{{ item.year }}</span></span>
    </a>
    {% endif %}
    {% endfor %}
  </nav>
  <p id="project-count" class="sr-only" aria-live="polite"></p>
</section>
