<section id="collection" class="collection" aria-labelledby="collection-title">
  <h2 id="collection-title" class="sr-only" tabindex="-1">{% if project %}More projects{% else %}Projects{% endif %}</h2>
  <nav id="strips" aria-label="Projects">
    {% for item in collectionItems %}
    <a class="strip" id="strip-{{ item.slug }}" data-project-link
      href="{{ ('/' ~ item.slug ~ '/') | url }}"
      data-project="{{ item.slug }}"{% if item.color %} style="--project-color: {{ item.color }}"{% endif %}
      {% if project and project.slug == item.slug %} hidden{% endif %}>
      <picture class="strip-picture">
        <source class="strip-wall-source" media="not all" type="image/avif" srcset="{{ item.thumbnail.wallAvif }}">
        <source class="strip-wall-source" media="not all" type="image/webp" srcset="{{ item.thumbnail.wallWebp }}">
        <source type="image/avif" srcset="{{ item.thumbnail.avif }}" sizes="(hover: none) calc(100vw - 48px), (max-width: 900px) calc(100vw - 48px), 80px">
        <source type="image/webp" srcset="{{ item.thumbnail.webp }}" sizes="(hover: none) calc(100vw - 48px), (max-width: 900px) calc(100vw - 48px), 80px">
        <img class="strip-image" src="{{ item.thumbnail.src }}" alt="" width="{{ item.thumbnail.width }}" height="{{ item.thumbnail.height }}" loading="lazy" decoding="async">
      </picture>
      <span class="strip-label">{{ item.title }}</span>
    </a>
    {% endfor %}
  </nav>
  <p id="project-count" class="sr-only" aria-live="polite"></p>
</section>
