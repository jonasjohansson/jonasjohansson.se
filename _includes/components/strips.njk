<section id="collection" class="collection" aria-labelledby="collection-title">
  <h2 id="collection-title" class="sr-only" tabindex="-1">{% if project %}More projects{% else %}Projects{% endif %}</h2>
  <nav id="strips" aria-label="Projects">
    {% for item in collectionItems %}
    <a class="strip" id="strip-{{ item.slug }}" data-project-link
      href="{{ ('/' ~ item.slug ~ '/') | url }}"
      aria-label="{% if indexPreview %}{{ item.year }} · {% endif %}{{ item.title | escape }}"
      data-project="{{ item.slug }}"{% if item.stripColor %} style="--project-color: {{ item.stripColor }}"{% endif %}
      {% if project and project.slug == item.slug %} hidden{% endif %}>
      <picture class="strip-picture">
        <source type="image/avif" srcset="{{ item.thumbnail.avif }}" sizes="(hover: none) calc(100vw - 48px), 640px">
        <source type="image/webp" srcset="{{ item.thumbnail.webp }}" sizes="(hover: none) calc(100vw - 48px), 640px">
        {%- set eager = (not project) and loop.index0 < 3 %}
        <img class="strip-image" src="{{ item.thumbnail.src }}" alt="" width="{{ item.thumbnail.width }}" height="{{ item.thumbnail.height }}" loading="{{ 'eager' if eager else 'lazy' }}"{% if eager and loop.first %} fetchpriority="high"{% endif %} decoding="async">
      </picture>
      <span class="strip-title" aria-hidden="true">{% if indexPreview %}{{ item.year }} · {% endif %}{{ item.title }}</span>
    </a>
    {% endfor %}
  </nav>
  <p id="project-count" class="sr-only" aria-live="polite"></p>
</section>
