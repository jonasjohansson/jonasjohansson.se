<nav
  id="strips"
  role="list">
  {% for project in projectsForJS %}
  <div
    class="strip"
    data-project="{{ project.slug }}"
    data-tags="{{ project.tags | join(',') }}">
    <div
      class="strip-image"
      data-bg-image="{{ project.images[0] }}"></div>
  </div>
  {% endfor %}

  <!-- Filter controls -->
  <div
    class="filter-dropdown"
    id="filter-dropdown-container"
    style="display: none">
    <button class="filter-dropdown-button">Filter</button>

    <div
      class="filter-dropdown-content"
      id="filter-dropdown">
      {% for tag in site.tags | sortByLength %}
      <label class="filter-option">
        <input
          type="checkbox"
          value="{{ tag }}"
          data-type="category" />
        <span>{{ tag | capitalize }}</span>
      </label>
      {% endfor %}
    </div>
  </div>
</nav>
