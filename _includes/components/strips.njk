<nav
  id="strips"
  aria-label="Projects">
  {% for project in projectsForJS %} {% set stripImage = project.images[0] %} {% if stripImage and not stripImage.startsWith('/') %} {% set
  stripImage = '/' ~ stripImage %} {% endif %} {% if project.type == 'placeholder' %}
  <!-- Work that isn't made yet: an empty slot in the wall, not a link -->
  <div
    class="strip strip-placeholder"
    data-project="{{ project.slug }}"
    data-project-title="{{ project.title | e('html_attr') }}"
    data-tags="">
    <span class="strip-label">{{ project.title }}</span>
  </div>
  {% else %}
  <a
    class="strip"
    href="/{{ project.slug }}/"
    aria-label="{{ project.title | e('html_attr') }}"
    data-project="{{ project.slug }}"
    data-project-title="{{ project.title | e('html_attr') }}"
    data-tags="{{ project.tags | join(',') }}">
    {% if project.heroVideo %}
    <video
      class="strip-video"
      src="{{ project.heroVideo }}"
      playsinline
      muted
      loop
      autoplay
      preload="auto"
      aria-hidden="true"></video>
    {% endif %}
    <div
      class="strip-image"
      data-bg-image="{{ stripImage }}"></div>
    <span class="strip-label">{{ project.title }}</span>
  </a>
  {% endif %} {% endfor %}
</nav>
