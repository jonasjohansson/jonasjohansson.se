<!-- Basic Meta Tags -->
<meta charset="utf-8" />
{% if project %}
{% set projectTitle = projectContent[project.slug].title %}
{% set projectDescription = projectContent[project.slug].content | findFirstText | stripHtml | truncate(160) %}
{% set hero = projectContent[project.slug].content[0] %}
{% if hero.type == 'video' %}<link rel="preload" as="image" href="{{ hero.poster }}" fetchpriority="high" data-hero-preload>{% endif %}
<title>{{ projectTitle }} | {{ site.title }}</title>
<meta
  name="description"
  content="{{ projectDescription or site.description }}" />
{% else %}
<title>{{ site.title }}</title>
<meta
  name="description"
  content="{{ (description or site.description) | truncate(160) }}" />
{% endif %}

<!-- Viewport and Mobile Optimization -->
<meta
  name="viewport"
  content="width=device-width, initial-scale=1, viewport-fit=cover" />
<meta
  name="mobile-web-app-capable"
  content="yes" />
<meta
  name="apple-mobile-web-app-status-bar-style"
  content="black" />
<meta
  name="theme-color"
  content="#1a1816" />

<!-- Preload critical fonts to avoid FOUT -->
<link
  rel="preload"
  as="font"
  type="font/woff"
  href="{{ 'SeasonMix-Regular.woff' | viteAsset | url }}"
  crossorigin />

<!-- Canonical URL -->
<link
  rel="canonical"
  href="{{ site.url }}{{ page.url | url }}" />

<!-- SEO and Performance -->
<meta
  name="robots"
  content="{{ 'noindex, nofollow' if project and project.unlisted else 'index, follow' }}" />
<meta
  name="author"
  content="Jonas Johansson" />
<meta
  name="keywords"
  content="artist, light art, interactive art, digital art, technology, installation, Sweden" />

<!-- Open Graph / Facebook -->
{% if project %}
{% set projectOgImage = projectContent[project.slug].ogImage %}
{% set ogTitle = projectTitle ~ ' | ' ~ site.title %}
{% set ogDescription = projectDescription or site.description %}
{% set ogUrl = site.url ~ (page.url | url) %}
{% set ogImagePath = projectOgImage %}
{% set ogImage = site.url ~ ogImagePath %}
{% set ogImageAlt = hero.alt %}
{% set ogType = "article" %}
{% else %}
{% set ogTitle = site.title %}
{% set ogDescription = description or site.description %}
{% set ogUrl = site.url ~ (page.url | url) %}
{% set ogImagePath = siteOgImage or site.meta.ogImage %}
{% set ogImage = site.url ~ ogImagePath %}
{% set ogImageAlt = site.title %}
{% set ogType = "website" %}
{% endif %}
<meta
  property="og:type"
  content="{{ ogType }}" />
<meta
  property="og:title"
  content="{{ ogTitle }}" />
<meta
  property="og:description"
  content="{{ ogDescription }}" />
<meta
  property="og:url"
  content="{{ ogUrl }}" />
<meta
  property="og:image"
  content="{{ ogImage }}" />
<meta
  property="og:image:secure_url"
  content="{{ ogImage }}" />
<meta
  property="og:image:type"
  content="image/jpeg" />
<meta
  property="og:image:width"
  content="1200" />
<meta
  property="og:image:height"
  content="630" />
<meta
  property="og:image:alt"
  content="{{ ogImageAlt }}" />
<meta
  property="og:site_name"
  content="{{ site.title }}" />
<meta
  property="og:locale"
  content="en_GB" />

<!-- Twitter Card -->
<meta
  name="twitter:card"
  content="summary_large_image" />
<meta
  name="twitter:title"
  content="{{ ogTitle }}" />
<meta
  name="twitter:description"
  content="{{ ogDescription }}" />
<meta
  name="twitter:image"
  content="{{ ogImage }}" />
<meta
  name="twitter:image:alt"
  content="{{ ogImageAlt }}" />

<!-- Performance and Security -->
<!-- Favicon and App Icons -->
<link
  rel="icon"
  type="image/png"
  href="{{ '/favicon/favicon-96x96.png' | url }}"
  sizes="96x96" />
<link
  rel="icon"
  type="image/svg+xml"
  href="{{ '/favicon/favicon.svg' | url }}" />
<link
  rel="shortcut icon"
  href="{{ '/favicon/favicon.ico' | url }}" />
<link
  rel="apple-touch-icon"
  sizes="180x180"
  href="{{ '/favicon/apple-touch-icon.png' | url }}" />
<meta
  name="apple-mobile-web-app-title"
  content="Jonas Johansson" />
<link
  rel="manifest"
  href="{{ '/favicon/site.webmanifest' | url }}" />

{% include './structured-data.njk' %}
