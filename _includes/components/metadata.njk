<!-- Basic Meta Tags -->
<meta charset="utf-8" />
<title>{{ site.title }}</title>
<meta
  name="description"
  content="{{ description or site.description }}" />

<!-- Viewport and Mobile Optimization -->
<meta
  name="viewport"
  content="width=device-width, initial-scale=1, viewport-fit=cover" />
<meta
  name="mobile-web-app-capable"
  content="yes" />
<meta
  name="apple-mobile-web-app-status-bar-style"
  content="black" />
<meta
  name="theme-color"
  content="#1a1a1a" />

<!-- Preload critical fonts to avoid FOUT -->
<link
  rel="preload"
  as="font"
  type="font/woff2"
  href="/assets/fonts/OffBit-Regular.BUl2rdng.woff2"
  crossorigin />
<link
  rel="preload"
  as="font"
  type="font/woff2"
  href="/assets/fonts/OffBit-101Bold.JQCzxZZ0.woff2"
  crossorigin />

{# Preload first strip/hero image to improve LCP #} {% if projectsForJS and projectsForJS[0] and projectsForJS[0].images and
projectsForJS[0].images[0] %}
<link
  rel="preload"
  as="image"
  href="{{ projectsForJS[0].images[0] }}"
  fetchpriority="high"
  imagesizes="100vw" />
{% endif %}

<!-- SEO and Performance -->
<meta
  name="robots"
  content="index, follow" />
<meta
  name="author"
  content="Jonas Johansson" />
<meta
  name="keywords"
  content="artist, light art, interactive art, digital art, technology, installation, Sweden" />

<!-- Project-specific metadata -->
{% if project %} {% set firstImage = projectContent[project.slug].content | findFirstImage %} {% set projectTitle =
projectContent[project.slug].title %} {% set projectDescription = projectContent[project.slug].content | findFirstText | truncate(160) %} {%
set projectUrl = site.url ~ page.url %} {% set projectImage = firstImage and (site.url ~ firstImage) or (site.url ~ site.meta.ogImage) %}

<!-- Open Graph / Facebook -->
<meta
  property="og:type"
  content="article" />
<meta
  property="og:title"
  content="{{ projectTitle }}" />
<meta
  property="og:description"
  content="{{ projectDescription }}" />
<meta
  property="og:url"
  content="{{ projectUrl }}" />
<meta
  property="og:image"
  content="{{ projectImage }}" />
<meta
  property="og:site_name"
  content="{{ site.title }}" />
<meta
  property="og:locale"
  content="en_US" />

<!-- Twitter -->
<meta
  name="twitter:card"
  content="summary_large_image" />
<meta
  name="twitter:title"
  content="{{ projectTitle }}" />
<meta
  name="twitter:description"
  content="{{ projectDescription }}" />
<meta
  name="twitter:image"
  content="{{ projectImage }}" />
{% else %}
<!-- Default site metadata -->
<meta
  property="og:type"
  content="website" />
<meta
  property="og:title"
  content="{{ title or site.title }}" />
<meta
  property="og:description"
  content="{{ description or site.description }}" />
<meta
  property="og:url"
  content="{{ site.url }}{{ page.url }}" />
<meta
  property="og:image"
  content="{{ site.url }}{{ site.meta.ogImage }}" />
<meta
  property="og:site_name"
  content="{{ site.title }}" />
<meta
  property="og:locale"
  content="en_US" />

<!-- Twitter -->
<meta
  name="twitter:card"
  content="summary_large_image" />
<meta
  name="twitter:title"
  content="{{ title or site.title }}" />
<meta
  name="twitter:description"
  content="{{ description or site.description }}" />
<meta
  name="twitter:image"
  content="{{ site.url }}{{ site.meta.ogImage }}" />
{% endif %}

<!-- Performance and Security -->
<meta
  http-equiv="X-Content-Type-Options"
  content="nosniff" />
<meta
  http-equiv="X-XSS-Protection"
  content="1; mode=block" />

<!-- Favicon and App Icons -->
<link
  rel="icon"
  type="image/png"
  href="/favicon-96x96.png"
  sizes="96x96" />
<link
  rel="icon"
  type="image/svg+xml"
  href="/favicon.svg" />
<link
  rel="shortcut icon"
  href="/favicon.ico" />
<link
  rel="apple-touch-icon"
  sizes="180x180"
  href="/apple-touch-icon.png" />
<meta
  name="apple-mobile-web-app-title"
  content="Jonas Johansson" />
<link
  rel="manifest"
  href="/site.webmanifest" />

<!-- Structured Data (JSON-LD) for Rich Snippets -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "{{ site.author }}",
  "alternateName": "{{ site.title }}",
  "url": "{{ site.url }}",
  "jobTitle": "{{ site.jobTitle or 'Artist, Educator, Designer' }}",
  "description": "{{ site.description }}",
  "email": "{{ site.contact.email or site.email }}",
  "image": "{{ site.url }}{{ site.meta.ogImage }}",
  "sameAs": [
    {% if site.contact.sameAs %}{% for link in site.contact.sameAs %}"{{ link }}"{% if not loop.last %},{% endif %}{% endfor %}{% else %}
    "https://twitter.com/jonasjohansson",
    "https://instagram.com/jonasjohansson"
    {% endif %}
  ]{% if site.location %},
  "address": {
    "@type": "PostalAddress",
    "addressCountry": "{{ site.location.addressCountry or 'SE' }}",
    "addressRegion": "{{ site.location.addressRegion or '' }}",
    "addressLocality": "{{ site.location.addressLocality or 'Stockholm' }}"
  }{% endif %},
  "knowsAbout": [
    {% for tag in site.tags %}"{{ tag }}"{% if not loop.last %},{% endif %}{% endfor %}
  ],
  "worksFor": {
    "@type": "Organization",
    "name": "Visualia",
    "url": "https://visualia.se"
  },
  "alumniOf": [
    {
      "@type": "Organization",
      "name": "Svenska Tecknare"
    },
    {
      "@type": "EducationalOrganization",
      "name": "Beckmans"
    },
    {
      "@type": "EducationalOrganization",
      "name": "Hyper Island"
    }
  ],
  "memberOf": [
    {
      "@type": "Organization",
      "name": "Nordic Audiovisual Artists",
      "url": "https://nava.community"
    },
    {
      "@type": "Organization",
      "name": "Svartljus",
      "url": "https://svartljus.se"
    }
  ]
}
</script>

<!-- WebSite Schema for Sitelinks -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "{{ site.title }}",
  "url": "{{ site.url }}",
  "description": "{{ site.description }}",
  "author": {
    "@type": "Person",
    "name": "{{ site.author }}"
  },
  "potentialAction": {
    "@type": "SearchAction",
    "target": {
      "@type": "EntryPoint",
      "urlTemplate": "{{ site.url }}/?s={search_term_string}"
    },
    "query-input": "required name=search_term_string"
  }
}
</script>

{% if project %}
<!-- CreativeWork Schema for Project Pages -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  "name": "{{ projectContent[project.slug].title }}",
  "description": "{{ projectContent[project.slug].content | findFirstText | truncate(160) }}",
  "url": "{{ site.url }}{{ page.url }}",
  "image": "{{ projectImage }}",
  "creator": {
    "@type": "Person",
    "name": "{{ site.author }}",
    "url": "{{ site.url }}"
  },
  "datePublished": "{{ projectContent[project.slug].date or project.date }}",
  "keywords": "{{ projectContent[project.slug].tags | join(', ') }}"
}
</script>
{% endif %}

<!-- External preconnects removed - not using external fonts -->
