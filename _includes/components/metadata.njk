<!-- Basic Meta Tags -->
<meta charset="utf-8" />
{% if project %}
{% set projectTitle = projectContent[project.slug].title %}
{% set projectDescription = projectContent[project.slug].content | findFirstText | stripHtml | truncate(160) %}
<title>{{ projectTitle }} — {{ site.title }}</title>
<meta
  name="description"
  content="{{ projectDescription or site.description }}" />
{% else %}
<title>{{ site.title }}</title>
<meta
  name="description"
  content="{{ (description or site.description) | truncate(160) }}" />
{% endif %}

<!-- Viewport and Mobile Optimization -->
<meta
  name="viewport"
  content="width=device-width, initial-scale=1, viewport-fit=cover" />
<meta
  name="mobile-web-app-capable"
  content="yes" />
<meta
  name="apple-mobile-web-app-status-bar-style"
  content="black" />
<meta
  name="theme-color"
  content="#1a1a1a" />

<!-- Preload critical fonts to avoid FOUT -->
<link
  rel="preload"
  as="font"
  type="font/woff2"
  href="/assets/fonts/OffBit-Regular.BUl2rdng.woff2"
  crossorigin />
<link
  rel="preload"
  as="font"
  type="font/woff2"
  href="/assets/fonts/OffBit-101Bold.JQCzxZZ0.woff2"
  crossorigin />

<!-- Preload about image only on about page to prevent pop-in when opening about -->
{% if page.url === '/about/' %}
<link
  rel="preload"
  as="image"
  href="/projects/about/01.jpg"
  fetchpriority="low" />
{% endif %}

{# Preload first strip/hero image to improve LCP #} {% if projectsForJS and projectsForJS[0] and projectsForJS[0].images and
projectsForJS[0].images[0] %}
<link
  rel="preload"
  as="image"
  href="{{ projectsForJS[0].images[0] }}"
  fetchpriority="high"
  imagesizes="100vw" />
{% endif %}

<!-- Canonical URL -->
<link
  rel="canonical"
  href="{{ site.url }}{{ page.url }}" />

<!-- SEO and Performance -->
<meta
  name="robots"
  content="index, follow" />
<meta
  name="author"
  content="Jonas Johansson" />
<meta
  name="keywords"
  content="artist, light art, interactive art, digital art, technology, installation, Sweden" />

<!-- Open Graph / Facebook -->
{% if project %}
{% set heroImage = projectContent[project.slug].heroImage %}
{% set ogTitle = projectTitle %}
{% set ogDescription = projectDescription or site.description %}
{% set ogUrl = site.url ~ page.url %}
{% set ogImage = heroImage and (site.url ~ heroImage) or (site.url ~ site.meta.ogImage) %}
{% set ogType = "article" %}
{% else %}
{% set ogTitle = title or site.title %}
{% set ogDescription = description or site.description %}
{% set ogUrl = site.url ~ page.url %}
{% set ogImage = site.url ~ site.meta.ogImage %}
{% set ogType = "website" %}
{% endif %}
<meta
  property="og:type"
  content="{{ ogType }}" />
<meta
  property="og:title"
  content="{{ ogTitle }}" />
<meta
  property="og:description"
  content="{{ ogDescription }}" />
<meta
  property="og:url"
  content="{{ ogUrl }}" />
<meta
  property="og:image"
  content="{{ ogImage }}" />
<meta
  property="og:image:type"
  content="image/jpeg" />
<meta
  property="og:site_name"
  content="{{ site.title }}" />
<meta
  property="og:locale"
  content="en_US" />

<!-- Twitter Card -->
<meta
  name="twitter:card"
  content="summary_large_image" />
<meta
  name="twitter:title"
  content="{{ ogTitle }}" />
<meta
  name="twitter:description"
  content="{{ ogDescription }}" />
<meta
  name="twitter:image"
  content="{{ ogImage }}" />

<!-- Performance and Security -->
<meta
  http-equiv="X-Content-Type-Options"
  content="nosniff" />
<!-- Favicon and App Icons -->
<link
  rel="icon"
  type="image/png"
  href="/favicon-96x96.png"
  sizes="96x96" />
<link
  rel="icon"
  type="image/svg+xml"
  href="/favicon.svg" />
<link
  rel="shortcut icon"
  href="/favicon.ico" />
<link
  rel="apple-touch-icon"
  sizes="180x180"
  href="/apple-touch-icon.png" />
<meta
  name="apple-mobile-web-app-title"
  content="Jonas Johansson" />
<link
  rel="manifest"
  href="/site.webmanifest" />

<!-- Structured Data (JSON-LD) for Rich Snippets -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "{{ site.author }}",
  "alternateName": "{{ site.title }}",
  "url": "{{ site.url }}",
  "jobTitle": "{{ site.jobTitle or 'Artist, Educator, Designer' }}",
  "description": "{{ site.description }}",
  "email": "{{ site.contact.email or site.email }}",
  "image": "{{ site.url }}{{ site.meta.ogImage }}",
  "sameAs": [
    {% if site.contact.sameAs %}{% for link in site.contact.sameAs %}"{{ link }}"{% if not loop.last %},{% endif %}{% endfor %}{% else %}
    "https://instagram.com/jonasjohansson"
    {% endif %}
  ]{% if site.location %},
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "{{ site.location.address or '' }}",
    "addressLocality": "{{ site.location.addressLocality or 'Stockholm' }}",
    "addressRegion": "{{ site.location.addressRegion or '' }}",
    "addressCountry": "{{ site.location.addressCountry or 'SE' }}"
  }{% endif %},
  "knowsAbout": [
    {% for tag in site.tags %}"{{ tag }}"{% if not loop.last %},{% endif %}{% endfor %}
  ],
  "worksFor": {
    "@type": "Organization",
    "name": "Visualia",
    "url": "https://visualia.se"
  },
  "alumniOf": [
    {
      "@type": "Organization",
      "name": "Svenska Tecknare"
    },
    {
      "@type": "EducationalOrganization",
      "name": "Beckmans"
    },
    {
      "@type": "EducationalOrganization",
      "name": "Hyper Island"
    }
  ],
  "memberOf": [
    {
      "@type": "Organization",
      "name": "Nordic Audiovisual Artists",
      "url": "https://nava.community"
    },
    {
      "@type": "Organization",
      "name": "Svartljus",
      "url": "https://svartljus.se"
    }
  ]
}
</script>

<!-- WebSite Schema for Sitelinks -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "{{ site.title }}",
  "url": "{{ site.url }}",
  "description": "{{ site.description }}",
  "author": {
    "@type": "Person",
    "name": "{{ site.author }}"
  },
  "potentialAction": {
    "@type": "SearchAction",
    "target": {
      "@type": "EntryPoint",
      "urlTemplate": "{{ site.url }}/?s={search_term_string}"
    },
    "query-input": "required name=search_term_string"
  }
}
</script>

{% if site.location and site.location.address %}
<!-- LocalBusiness/Organization Schema for Location and Map -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "{{ site.title }}",
  "alternateName": "{{ site.subtitle }}",
  "url": "{{ site.url }}",
  "description": "{{ site.description }}",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "{{ site.location.address }}",
    "addressLocality": "{{ site.location.addressLocality }}",
    "addressRegion": "{{ site.location.addressRegion }}",
    "addressCountry": "{{ site.location.addressCountry }}"
  }{% if site.location.geo %},
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": "{{ site.location.geo.latitude }}",
    "longitude": "{{ site.location.geo.longitude }}"
  }{% endif %},
  "contactPoint": {
    "@type": "ContactPoint",
    "email": "{{ site.contact.email or site.email }}",
    "contactType": "artist, educator, designer"
  }
}
</script>
{% endif %}

{% if project %}
<!-- CreativeWork Schema for Project Pages -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  "name": "{{ projectContent[project.slug].title }}",
  "description": "{{ projectContent[project.slug].content | findFirstText | stripHtml | truncate(160) }}",
  "url": "{{ site.url }}{{ page.url }}",
  "image": "{{ ogImage }}",
  "creator": {
    "@type": "Person",
    "name": "{{ site.author }}",
    "url": "{{ site.url }}"
  },
  "datePublished": "{{ projectContent[project.slug].date or project.date }}",
  "keywords": "{{ projectContent[project.slug].tags | join(', ') }}"
}
</script>
{% endif %}

<!-- External preconnects removed - not using external fonts -->
