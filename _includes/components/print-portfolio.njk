{# Present at build time so browser-menu printing also works without JavaScript. #}
<style media="print">
  {% for item in collectionItems %}
  html[data-project="{{ item.slug }}"] body .print-project[data-print-project="{{ item.slug }}"] { display: block; }
  {% endfor %}
</style>
<div class="print-portfolio">
  <section class="print-page print-cover">
    <h1>{{ site.author }}</h1>
    <div class="print-bio">{{ site.intro | markdown | safe }}</div>
    <div class="print-contact">
      <a href="{{ site.url }}">{{ site.url | replace('https://', '') }}</a><br>
      <a href="mailto:{{ site.email }}">{{ site.email }}</a>
      <div class="print-profile-links">
        {%- set shown = [] %}
        {%- for contact in site.contacts %}
        {%- if not contact.action and contact.href != ("mailto:" ~ site.email) %}
        {{- "" if shown.push(contact) }}{% if shown.length > 1 %} · {% endif %}<a href="{{ contact.href }}">{{ contact.label }}</a>
        {%- endif %}
        {%- endfor %}
      </div>
    </div>
  </section>
  {% for item in collectionItems %}
  <article class="print-project" data-print-project="{{ item.slug }}">
    {# One sheet, one photograph. Writing that would overrun is set smaller. #}
    <section class="print-page print-project-page" style="--copy-scale: {{ item.printCopyScale }}">
      <img class="print-hero" src="{{ item.printMedia[0].src }}" alt="{{ item.printMedia[0].alt }}" width="{{ item.printMedia[0].width }}" height="{{ item.printMedia[0].height }}" style="object-position: {{ item.content[0].focal }}" loading="lazy" decoding="async">
      <div class="print-project-text">
        {# Raster alpha survives PDF viewers that misrender nested vector masks. #}
        {% if item.printMedia[0].shade %}
        <div class="print-shade" aria-hidden="true">
          <img src="{{ item.printMedia[0].shadeBody }}" alt="" width="800" height="800" loading="lazy" decoding="async">
        </div>
        {% endif %}
        <h2><a href="{{ site.url }}{{ ('/' ~ item.slug ~ '/') | url }}">{{ item.title }}</a></h2>
        <div class="print-copy">
          {% for block in item.printCopy %}
          <div{% if loop.first %} class="print-lead"{% endif %}>{{ block.content | safe }}</div>
          {% endfor %}
        </div>
        {# Printed on its own, a project carries all of its writing on the cover. #}
        <div class="print-copy print-copy-full">
          {% for block in item.printCopyFull %}
          <div{% if loop.first %} class="print-lead"{% endif %}>{{ block.content | safe }}</div>
          {% endfor %}
        </div>
        <p class="print-project-link"><a href="{{ site.url }}{{ ('/' ~ item.slug ~ '/') | url }}">View full project ↗</a></p>
      </div>
    </section>
  </article>
  {% endfor %}
</div>
