{# A self-contained proposal at /preview/index/, using the real strip wall.
   The public homepage never includes these styles or behaviour. #}
<style>
  body[data-index-view="index"] #strips {
    --strip-min-width: var(--spacing-xl);
    --strip-grow: 1;
    --index-font-size: clamp(0.75rem, 0.95vw, var(--font-size-ui));
    border-block: 1px solid var(--border-muted);
    border-inline-start: 1px solid var(--border-muted);
    touch-action: pan-x pan-y;
  }
  body[data-index-view="index"] .strip::after {
    content: '';
    position: absolute;
    inset: 0;
    box-shadow: inset -1px 0 var(--border-muted);
    pointer-events: none;
  }
  body[data-index-view="index"] .strip-title {
    display: block;
    position: absolute;
    bottom: var(--spacing-sm);
    left: 50%;
    z-index: 1;
    max-height: calc(100% - 2 * var(--spacing-sm));
    writing-mode: vertical-rl;
    transform: translateX(-50%) rotate(180deg);
    font-size: var(--index-font-size);
    line-height: var(--line-height-ui);
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-caps);
    color: var(--color-white);
    text-shadow: 0 1px var(--spacing-xs) var(--color-black);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    pointer-events: none;
  }
  body[data-index-view="index"] .strip:focus-visible { outline-color: var(--color-white); }
  .project-filters .index-toggle {
    flex: none;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    font: inherit;
  }
  .project-filters .index-toggle:hover { text-decoration: underline; }
  .project-filters .index-toggle:focus-visible { outline-offset: -2px; }
</style>

<script type="module">
  // Wait for the existing wall and filters; the shared module runs only once.
  import "{{ 'main.js' | viteAsset | url }}";

  const collection = document.getElementById('collection');
  const strips = document.getElementById('strips');
  const toggle = document.createElement('button');
  toggle.type = 'button';
  toggle.className = 'index-toggle';
  toggle.setAttribute('aria-controls', 'strips');
  document.getElementById('project-filters').append(toggle);

  // Keep the demo open when following a project.
  for (const link of strips.querySelectorAll('a')) {
    link.target = '_blank';
    link.rel = 'noopener';
  }

  const showingIndex = () => document.body.dataset.indexView === 'index';
  // Names are already visible, so touch can scroll the wall naturally and
  // enter with one tap instead of using the image wall's preview gesture.
  for (const type of ['pointerdown', 'pointermove', 'touchmove', 'click']) {
    collection.addEventListener(type, event => {
      if (showingIndex()) event.stopPropagation();
    }, { capture: true, passive: true });
  }

  function setView(showIndex, announce = false) {
    document.body.dataset.indexView = showIndex ? 'index' : 'images';
    toggle.textContent = showIndex ? 'Images' : 'Index';
    toggle.setAttribute('aria-label', showIndex ? 'Show images only' : 'Show project names');
    if (announce) {
      document.getElementById('route-announcer').textContent = showIndex ? 'Project images with names shown' : 'Project images shown';
    }
    // Let the original wall update image sizes after restoring its widths.
    dispatchEvent(new Event('resize'));
  }
  toggle.addEventListener('click', () => setView(!showingIndex(), true));
  setView(new URLSearchParams(location.search).get('view') === 'index');
</script>
