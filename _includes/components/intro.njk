<div id="intro" class="intro"{% if project %} hidden{% endif %}>
  <h1 id="home-title" tabindex="-1">{{ site.title }}</h1>
  <p class="intro-summary">{{ site.summary }}</p>
  <nav class="intro-actions" aria-label="Introduction">
    <a href="#collection">Projects ↓</a>
    <a href="{{ site.aboutUrl }}" target="_blank" rel="noopener noreferrer">CV ↗</a>
    <a href="mailto:{{ site.email }}">Email ↗</a>
  </nav>
  <details id="about" class="about-details">
    <summary>About Jonas</summary>
    <div class="intro-text">{{ site.intro | markdown | safe }}</div>
  </details>
</div>
