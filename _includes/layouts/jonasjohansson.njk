<!DOCTYPE html>
<html lang="en"{% if project %} data-project="{{ project.slug }}"{% endif %}>
  <head>
    {% include "../components/metadata.njk" %}

    <link
      rel="stylesheet"
      href="{{ 'styles.css' | viteAsset | url }}" />

    {% include "../components/app-data.njk" %}
  </head>
  <body>
    {% include "../components/route-init.njk" %}
    <!-- Loading screen - shown while assets are loading -->
    <div id="loading-screen" role="status" aria-label="Loading">
      <div id="loading-spinner"></div>
    </div>

    <!-- Skip to content link for keyboard users -->
    <a href="#main" class="skip-link">Skip to content</a>

    {% include "../components/shader.njk" %}
    {% include "../components/header.njk" %}

      <div id="content">
        <aside id="about" role="dialog" aria-modal="false" aria-label="About Jonas Johansson" {% if page.url === '/about/' %}data-initial-about="true"{% endif %}>
          <div class="about-container">
            <div class="about-text">
              <div class="about-text-inner">
                {% if about %}
                  {{ about | markdown | safe }}
                {% endif %}
              </div>
            </div>
            <div class="about-image">{% responsiveImage "projects/about/01.jpg", "Jonas Johansson" %}</div>
          </div>
        </aside>

        <main id="main">
          {{ content | safe }}
        </main>

        {% include "../components/strips.njk" %}
      </div>

    <script
      type="module"
      src="{{ 'main.js' | viteAsset | url }}"></script>
  </body>
</html>
