<!DOCTYPE html>
<html lang="en"{% if project %} data-project="{{ project.slug }}"{% endif %}>
  <head>
    {% include "../components/metadata.njk" %}

    <link
      rel="stylesheet"
      href="{{ 'styles.css' | viteAsset | url }}" />

    {% include "../components/app-data.njk" %}

    <script>
      (function() {
        var h = new Date().getHours();
        if (h >= 18 || h < 7) document.documentElement.setAttribute('data-theme', 'dark');
      })();
    </script>
  </head>
  <body>
    {% include "../components/route-init.njk" %}

    <!-- Skip to content link for keyboard users -->
    <a href="#main" class="skip-link">Skip to content</a>

    <!-- Live region for SPA navigation announcements -->
    <div id="route-announcer" class="sr-only" aria-live="polite" aria-atomic="true"></div>

    {% include "../components/header.njk" %}

      <div id="content">
        {% if not project %}
        <h1 class="sr-only">Jonas Johansson — artist, educator and designer</h1>
        {% endif %}
        {% include "../components/intro.njk" %}

        <main id="main">
          {{ content | safe }}
        </main>

        {% include "../components/strips.njk" %}
      </div>


    <script
      type="module"
      src="{{ 'main.js' | viteAsset | url }}"></script>
  </body>
</html>
