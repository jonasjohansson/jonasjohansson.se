<!DOCTYPE html>
<html lang="en">
  <head>
    {% include "../components/metadata.njk" %}

    <link
      rel="stylesheet"
      href="{{ 'styles.css' | viteAsset | url }}" />

    <script>
      window.__PATH_PREFIX__ = "{{ '/' | url }}".replace(/\/$/, '');
      window.__PROJECTS_DATA__ = {{ projectsForJS | dump | safe }};
      {% if project %}
      window.__INITIAL_PROJECT__ = {{ project | dump | safe }};
      {% endif %}
    </script>
  </head>
  <body>
    <section id="intro-section">
      <div class="intro-content">
        <!-- About text with auto-flow across columns -->
        <div class="about-text">
          {{ about | markdown | safe }}
        </div>
      </div>
    </section>

    {% include "../components/header.njk" %}

    <div id="strips-wrapper">
      {{ content | safe }}
      {% include "../components/strips.njk" %}
    </div>

    <script
      type="module"
      src="{{ 'main.js' | viteAsset | url }}"></script>
  </body>
</html>
