<!DOCTYPE html>
<html lang="en">
  <head>
    {% include "../components/metadata.njk" %}

    <link
      rel="stylesheet"
      href="{{ 'styles.css' | viteAsset | url }}" />

    <script>
      window.__PATH_PREFIX__ = "{{ '/' | url }}".replace(/\/$/, '');
      window.__PROJECTS_DATA__ = {{ projectsForJS | dump | safe }};
      window.__SITE_TITLE__ = {{ site.title | dump | safe }};
      {% if project %}
      window.__INITIAL_PROJECT__ = {{ project | dump | safe }};
      {% endif %}
    </script>
  </head>
  <body>
    <div id="site-container">
      {% include "../components/header.njk" %}

      <!-- About overlay - full screen overlay with about content -->
      <aside id="about-overlay" class="about-overlay">
        <div class="about-container">
          <div class="about-text">
            <div class="about-text-inner">
              {% if about %}
                {{ about | markdown | safe }}
              {% endif %}
            </div>
          </div>
          <div class="about-image">
            {% responsiveImage "projects/about/01.jpg", "Jonas Johansson" %}
          </div>
        </div>
      </aside>

      <!-- Wrapper for main content -->
      <div id="content-wrapper">
        <main id="main">
          {{ content | safe }}
        </main>

        {% include "../components/strips.njk" %}
      </div>


    <script
      type="module"
      src="{{ 'main.js' | viteAsset | url }}"></script>
  </body>
</html>
