<!DOCTYPE html>
<html lang="en">
  <head>
    {% include "../components/metadata.njk" %}

    <link
      rel="stylesheet"
      href="{{ 'styles.css' | viteAsset | url }}" />

    <script>
      window.__PATH_PREFIX__ = "{{ '/' | url }}".replace(/\/$/, '');
      window.__PROJECTS_DATA__ = {{ projectsForJS | dump | safe }};
      {% if project %}
      window.__INITIAL_PROJECT__ = {{ project | dump | safe }};
      {% endif %}
    </script>
  </head>
  <body>
    {% if not project %}
    <!-- Loading screen - only percentage -->
    <div id="loading-screen">
      <div id="loading-percentage">0%</div>
    </div>
    {% endif %} {% include "../components/header.njk" %}

    <!-- About section (aside) -->
    <aside
      id="about-section"
      class="about-section">
      <div class="about-content">
        <div class="about-columns">
          {{ about | markdown | safe }}
        </div>
      </div>
    </aside>

    <!-- Wrapper for main content that gets pushed down -->
    <div id="content-wrapper">
      <main id="main">
        {{ content | safe }}
      </main>

      {% include "../components/strips.njk" %}
    </div>

    <script
      type="module"
      src="{{ 'main.js' | viteAsset | url }}"></script>
  </body>
</html>
