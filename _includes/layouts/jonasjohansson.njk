<!DOCTYPE html>
<html lang="en"{% if project %} data-project="{{ project.slug }}"{% if project.color %} style="--project-color: {{ project.color }}"{% endif %}{% endif %}>
  <head>
    {% include "../components/metadata.njk" %}
    <script>
      (function () {
        var dark = matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.dataset.theme = dark ? 'dark' : 'light';
      })();
    </script>
    <link rel="stylesheet" href="{{ 'styles.css' | viteAsset | url }}">
    {% include "../components/app-data.njk" %}
  </head>
  <body data-route="{{ 'project' if project else 'home' }}">
    <a href="#main" class="skip-link">Skip to content</a>
    <div id="route-announcer" class="sr-only" aria-live="polite" aria-atomic="true"></div>
    {% include "../components/header.njk" %}
    <div id="navigation-status" class="navigation-status" hidden>
      <p id="navigation-message" role="status"></p>
      <div id="navigation-actions" hidden>
        <button type="button" id="navigation-retry">Try again</button>
        <a id="navigation-fallback">Open page</a>
        <button type="button" id="navigation-dismiss">Dismiss</button>
      </div>
    </div>
    <div id="content">
      <main id="main" tabindex="-1">
        {% include "../components/intro.njk" %}
        <div id="projects" class="projects-container">{{ content | safe }}</div>
        {% include "../components/strips.njk" %}
      </main>
      {% include "../components/intro-links.njk" %}
    </div>
    <script type="module" src="{{ 'main.js' | viteAsset | url }}"></script>
  </body>
</html>
