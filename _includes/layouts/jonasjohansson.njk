<!DOCTYPE html>
<html lang="en">
  <head>
    {% include "../components/metadata.njk" %}

    <link
      rel="stylesheet"
      href="{{ 'styles.css' | viteAsset | url }}" />

    <script>
      window.__PATH_PREFIX__ = "{{ '/' | url }}".replace(/\/$/, '');
      window.__PROJECTS_DATA__ = {{ projectsForJS | dump | safe }};
      {% if project %}
      window.__INITIAL_PROJECT__ = {{ project | dump | safe }};
      {% endif %}
    </script>
  </head>
  <body>
    {% if not project %}
    <!-- Loading screen - only on root page -->
    <div id="loading-screen">
      <div id="loading-intro">
        <div class="about-columns">
          {{ about | markdown | safe }}
        </div>
      </div>
      <div class="button-group">
        <button
          id="start-button"
          disabled>
          EASY
        </button>
        <button
          id="difficult-button"
          disabled>
          DIFFICULT
        </button>
      </div>
    </div>

    <!-- Intro section that slides in from top - only on root page -->
    <div id="intro-section">
      <div class="about-grid">
        <div class="about-columns">
          {{ about | markdown | safe }}
        </div>
      </div>
    </div>
    {% endif %}

    {% include "../components/header.njk" %}

    <main id="main">
      {{ content | safe }}
    </main>

    {% include "../components/strips.njk" %}

    <script
      type="module"
      src="{{ 'main.js' | viteAsset | url }}"></script>
  </body>
</html>
