---
layout: jonasjohansson.njk
pagination:
  data: projects
  size: 1
  alias: project
  addAllPagesToCollections: true
permalink: "{{ project.slug }}/"
eleventyComputed:
  title: "{{ project.title }}"
---

{# The #projects wrapper lives in the layout so that it exists on every route,
   including the home page, and a client-side navigation always has somewhere to
   append a fetched section. #}
<section
  class="project visible"
  id="{{ project.slug }}"
  data-project="{{ project.slug }}">
    <h1 class="project-title" tabindex="-1">{{ projectContent[project.slug].title }}</h1>
    <div class="project-grid">
      {# The figure markup is repeated rather than factored into a macro:
         responsiveImage is an async shortcode and Nunjucks macros are
         synchronous, so calling it inside one silently renders nothing. #}
      {% for block in projectContent[project.slug].content %}

      {% if block.type == 'row' %}
      <div class="media-row" style="--ar-sum: {{ block.arSum }}; --gutters: {{ block.gutters }}">
        {% for item in block.items %}
        <figure class="media-item{% if item.size %} size-{{ item.size }}{% endif %}{% if item.mask == 'botanical-circle' %} mask-botanical-circle{% endif %}{% if item.zoom %} media-zoom{% endif %}" style="--ar: {{ item.ar }}{% if item.zoom %}; --image-zoom: {{ item.zoom }}; --focal: {{ item.focal }}{% endif %}">
          {% responsiveImage item.src, item.alt, "media-img", item.sizes %}
        </figure>
        {% endfor %}
      </div>

      {% elif block.type == 'image' %}
      <figure class="media-item{% if loop.first %} hero hero-{{ block.heroFit }}{% endif %}{% if block.size %} size-{{ block.size }}{% endif %}{% if block.ar and block.ar >= 1 and not loop.first %} wide{% endif %}{% if block.mask == 'botanical-circle' %} mask-botanical-circle{% endif %}{% if block.zoom %} media-zoom{% endif %}"
        style="{% if block.colStart %}--col-start: {{ block.colStart }}; --col-span: {{ block.colSpan }};{% endif %}{% if block.ar %} --ar: {{ block.ar }};{% endif %}{% if block.zoom %} --image-zoom: {{ block.zoom }}; --focal: {{ block.focal }};{% endif %}{% if loop.first %} --focal: {{ block.focal }}; --mobile-focal: {{ block.mobileFocal }}; --mobile-ar: {{ block.mobileAr }};{% endif %}">
        {% responsiveImage block.src, block.alt, ("media-img lcp" if loop.first else "media-img"), block.sizes, block.mobileSrc %}
      </figure>

      {% elif block.type == 'video' %}
      <figure class="media-item{% if loop.first %} hero hero-{{ block.heroFit }}{% endif %}{% if block.size %} size-{{ block.size }}{% endif %}{% if block.ar and block.ar >= 1 and not loop.first %} wide{% endif %}"
        style="{% if block.colStart %}--col-start: {{ block.colStart }}; --col-span: {{ block.colSpan }};{% endif %}{% if block.ar %} --ar: {{ block.ar }};{% endif %}{% if loop.first %} --focal: {{ block.focal }}; --mobile-focal: {{ block.mobileFocal }}; --mobile-ar: {{ block.mobileAr }};{% endif %}">
        <video
          class="media-video"
          src="{{ block.src | url }}"
          playsinline
          muted
          loop
          {% if not loop.first %}controls{% endif %}
          preload="none"
          {% if block.poster %}poster="{{ block.poster }}"{% endif %}
          aria-label="{{ block.alt }}"
          data-preview></video>
      </figure>

      {% elif block.type == 'audio' %}
      <div class="text-block text-small audio-block" style="--col-start: {{ block.colStart }}; --col-span: {{ block.colSpan }}">
        <p>{{ block.label }}</p>
        <audio controls preload="none" aria-label="{{ block.label }}" src="{{ block.src | url }}"></audio>
      </div>

      {% elif block.type == 'text' %}
      <div
        class="text-block {{ block.fontSizeClass or 'text-medium' }}"
        style="--col-start: {{ block.colStart }}; --col-span: {{ block.colSpan }}">
        {{ block.content | safe }}
      </div>

      {% elif block.type == 'credits' %}
      <aside class="credits-block" style="--col-start: {{ block.colStart }}; --col-span: {{ block.colSpan }}">
        <ul class="credits-list">
          {% for credit in block.credits %}
          <li>{{ credit | safe }}</li>
          {% endfor %}
        </ul>
      </aside>
      {% endif %}

      {% endfor %}
      {% if projectContent[project.slug].presskit %}
      <p class="presskit-block">
        <a href="{{ projectContent[project.slug].presskit }}" target="_blank" rel="noopener noreferrer">Press kit</a>
      </p>
      {% endif %}
    </div>
</section>
