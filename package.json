{
  "name": "11ty",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite build --watch\" \"eleventy --serve\"",
    "start": "eleventy --serve",
    "clean:img": "node scripts/clean-img.js",
    "clean:dist": "node scripts/clean-dist.js",
    "build": "npm run clean:dist && ELEVENTY_RUN_MODE=build npx vite build && ELEVENTY_RUN_MODE=build npx eleventy && echo '\u2713 Build complete - HTML files generated in dist/'",
    "test": "node --test tests/*.test.js",
    "test:browser": "node scripts/site-smoke.mjs",
    "test:print": "node scripts/print-smoke.mjs",
    "audit:visual": "node scripts/visual-audit.mjs"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.2",
    "@11ty/eleventy-img": "^6.0.4",
    "concurrently": "^9.2.1",
    "html-minifier-terser": "^7.2.0",
    "markdown-it": "^14.1.0",
    "nunjucks": "^3.2.4",
    "playwright": "^1.60.0",
    "sharp": "^0.33.5",
    "terser": "^5.44.0",
    "vite": "^7.1.9"
  },
  "dependencies": {
    "gray-matter": "^4.0.3"
  }
}
