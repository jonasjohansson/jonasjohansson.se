{
  "name": "11ty",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite build --watch\" \"eleventy --serve\"",
    "start": "eleventy --serve",
    "clean:img": "node scripts/clean-img.js",
    "clean:dist": "node scripts/clean-dist.js",
    "build": "npm run clean:dist && ELEVENTY_RUN_MODE=build npx vite build && ELEVENTY_RUN_MODE=build npx eleventy && echo '✓ Build complete - HTML files generated in dist/'"
  },
  "devDependencies": {
    "@11ty/eleventy": "3.1.0",
    "@11ty/eleventy-img": "^6.0.4",
    "@11ty/eleventy-plugin-vite": "^7.1.0-alpha.2",
    "concurrently": "^9.2.1",
    "fast-average-color-node": "^3.1.0",
    "html-minifier-terser": "^7.2.0",
    "lil-gui": "^0.21.0",
    "markdown-it": "^14.1.0",
    "nunjucks": "^3.2.4",
    "sharp": "^0.34.3",
    "terser": "^5.44.0",
    "vite": "^7.1.9"
  },
  "dependencies": {
    "gray-matter": "^4.0.3"
  }
}
