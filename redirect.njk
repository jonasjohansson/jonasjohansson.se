---
pagination:
  data: projectRedirects
  size: 1
  alias: redirect
permalink: "{{ redirect.oldSlug }}/"
eleventyExcludeFromCollections: true
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta http-equiv="refresh" content="0; url={{ ('/' ~ redirect.newSlug ~ '/') | url }}">
  <link rel="canonical" href="{{ ('/' ~ redirect.newSlug ~ '/') | url }}">
  <title>Redirecting...</title>
</head>
<body>
  <p>Redirecting to <a href="{{ ('/' ~ redirect.newSlug ~ '/') | url }}">/{{ redirect.newSlug }}/</a></p>
</body>
</html>
