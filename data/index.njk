<!DOCTYPE html>
<html lang="en">
    <head>
        <title>{{ site.title }}</title>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta property="og:url" content="{{ site.url }}" />
        <meta property="og:type" content="website" />
        <meta property="og:title" content="{{ site.title }}" />
        <meta property="og:image" content="{{ site.url }}{% img site.cover %}" />
        <meta property="og:description" content="{{ site.description }}" />
        <meta name="description" content="{{ site.description }}" />
        <meta name="apple-mobile-web-app-capable" content="yes" />
        <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
        <link rel="preload" as="font" href="/fonts/NotoSans-Light.woff2" type="font/woff2" crossorigin="anonymous" />
        <link rel="apple-touch-icon" href="/favicon.png" />
        <link rel="icon" href="/favicon.png" />
		{% set css %} 
			{% include "assets/css/reset.css" %} 
			{% include "assets/css/style.css" %} 
			{% include "assets/css/projects.css" %}
			{% include "assets/css/resume.css" %}
			{% include "assets/css/animation.css" %}
			{% include "assets/css/print.css" %}
			{# {% include "assets/css/sbol.css" %} #}
		{% endset %}
		<style>{{ css | cssmin | safe }}</style>
		{% set js %} 
			{% include "assets/js/app.js" %}
			{# {% include "assets/js/sbol.js" %} #}
		{% endset %}
		<script async defer> {{ js | jsmin | safe }}</script>
    </head>
    <body class="loading">
        <section id="intro">
            <p>
                <a href="mailto:jns.johansson@gmail.com">Jonas Johansson</a> is an anywhere based <span data-effect="shk" data-delay="5">designer</span> transforming <span data-effect="inv">light</span></a> ✺ <span data-effect="shf" data-delay="10">technology</span> through <span data-effect="wvy" data-delay="100">play</span> ❋ science
                and (un)human intervention
            </p>
            <nav data-no-print>
                <div>
                    <a href="http://svartljus.se/">Svartljus &#x2600;&#xFE0E;</a>
                </div>
                <div>
                    <a href="https://nava.community/">Nordic Audiovisual Artists</a>
                </div>
                <div>
                    <a href="https://www.exploring.technology/">Exploring Technology</a>
                </div>
                <div>
                    <a href="https://jonasjohansson.itch.io/homie">Homie</a>, <a href="https://jonasjohansson.itch.io/mio">Mio</a> & <a href="https://jonasjohansson.itch.io/conrad">Conrad</a>
                </div>
                <div>
                    <a href="https://www.blivande.com/">Blivande</a>
                </div>
            </nav>
            {# <p data-no-print>
                Say hi ❀
                <a href="https://facebook.com/jnsjohansson">Messenger</a>
                or
                <a href="mailto:jns.johansson@gmail.com">Mail</a>
            </p> #}
            {# <div id="currently">
                {% for item in site.currently %}
                <p>
                    {% if item.link %}
                    <a href="{{ item.link }}">{{ item.title }}</a>
                    {% else %}
                    {{ item.title }}
                    {% endif %}
                </p>
                {% endfor %}
            </div> #}
        </section>
        <section id="projects" data-no-print>
            <h3 id="info"></h3>
            {% for project in projects %} {% if project.hidden !== true %}
            <div class="project" data-title="{{ project.title }}">
                {% for media in project.media %}
                <div class="slide">
                    {% gallery media %}
                </div>
                {% endfor %}
            </div>
            {% endif %} {% endfor %}
            {# <div class="group" data-title="{{ gallery[0].title }}">
                {% for mediaItem in gallery[0].media %}
                <div class="slide">{% gallery mediaItem %}</div>
                {% endfor %}
            </div> #}
        </section>
        <section id="resume">
            <div data-no-print>
                Print <a onclick="window.print();return false;">full CV</a> 
            </div>
            {% for heading in ['work','education','projects','teaching','workshops','exhibition','talks'] %}
            <div>
                <h3>{{ resume.titles[heading] }}</h3>
                {% for entry in resume[heading] %} {% if entry.hidden !== true %}
                <div data-title="{{ entry['title'] }}" data-start="{{ entry['date-start'] }}" data-end="{{ entry['date-end'] }}">
                {% if entry.links %} <a href="{{ entry.links[0] }}"> {% endif %}
                {% if entry.title %} {{ entry.title }}. {% endif %}
                {% if entry.location %} {{ entry.location }} {% endif %}
                {% if entry.links %} </a> {% endif %}
                    {# {% if entry.links %}
                    <span class="links" data-no-print>
                        {% for link in entry.links %}
                        <a href="{{ link }}">1</a>
                        {% endfor %}
                    </span>
                    {% endif %} #}
                </div>
                {% endif %} {% endfor %}
            </div>
            {% endfor %}
            <div data-no-print>
                <h3>Friends & Collaborators</h3>
                {% for friend in friends %} 
                <div>
                    <a href="{{ friend.link }}">
                        {% if friend.title %} {{ friend.title }} {% endif %}
                    </a>
                </div>
                {% endfor %}
            </div>
        </section>
    </body>
</html>
