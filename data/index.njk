<!DOCTYPE html>
<html lang="en">
    <head>
        <title>{{ site.title }}</title>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta property="og:url" content="{{ site.url }}" />
        <meta property="og:type" content="website" />
        <meta property="og:title" content="{{ site.title }}" />
        <meta property="og:image" content="{% img site.cover %}" />
        <meta name="description" property="og:description" content="{{ site.description }}" />
		<meta name="apple-mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
		<link rel="apple-touch-icon" href="/favicon.png">
		<link rel="icon"href="/favicon.png">
		{% set css %} 
			{% include "assets/css/reset.css" %} 
			{% include "assets/css/style.css" %} 
			{% include "assets/css/gallery.css" %}
			{% include "assets/css/resume.css" %}
			{% include "assets/css/type.css" %}
			{% include "assets/css/print.css" %}
		{% endset %}
		<style>{{ css | cssmin | safe }}</style>
		{% set js %} 
			{% include "assets/js/app.js" %}
		{% endset %}
		<script> {{ js | jsmin | safe }}</script>
	</head>
	<body>
		<section id="intro">
			<p>
				Jonas Johansson is an anywhere based artist transforming light ✺ technology through ❋ play, education
				and (un)human intervention
			</p>
			<p data-no-print>
				Say hi ❀ <a href="https://facebook.com/jnsjohansson">Messenger</a> or <a href="mailto:jns.johansson@gmail.com">Mail</a>
			</p>
		</section>
		<section id="gallery" data-no-print>
			<h3 id="info"></h3>
			{% for galleryItem in gallery %}
			<div class="group" data-title="{{ galleryItem.title }}">
				{% for mediaItem in galleryItem.media %}
				<div class="slide">{% gallery mediaItem %}</div>
				{% endfor %}
			</div>
			{% endfor %}
		</section>
		<section id="resume">
			{# <div data-no-print>
				<a onclick="window.print();return false;">Print</a>
				for full resumé
			</div> #}
			{% for heading in ['work','education','projects','teaching','talks'] %}
			<div>
				<h3>{{ resume.titles[heading] }}</h3>
				{% for entry in resume[heading] %} {% if entry.hidden !== true %}
				<div data-start="{{ entry['date-start'] }}" data-end="{{ entry['date-end'] }}">
					{% if entry.link %}
					<a href="{{ entry.link }}">
						{% endif %} {% if entry.title %} {{ entry.title }}. {% endif %} {# {% if entry.winner === true %}
						<span class="emoji">🏆</span>
						{% endif %} #} {% if entry.location %} {{ entry.location }} {% endif %} {% if entry.link %}
					</a>
					{% endif %} {# {% if entry.link %}
					<a href="{{ entry.link }}">⭢</a>
					{% endif %} #}
				</div>
				{% endif %} {% endfor %}
			</div>
			{% endfor %}
		</section>
	</body>
</html>
